<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" version="2.5">
  <display-name>IPAM</display-name>

  <context-param>
    <param-name>majorBuildNumber</param-name>
    <param-value>${project.version}</param-value>
  </context-param>
  <context-param>
    <param-name>minorBuildNumber</param-name>
    <param-value>000</param-value>
  </context-param>
  <context-param>
    <param-name>buildTimestamp</param-name>
    <param-value>${timestamp}</param-value>
  </context-param>

  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>
</web-app>